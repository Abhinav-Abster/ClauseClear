# Google Gemini API Key (Required for live AI features)
# Obtain your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Overrides (defaults to gemini-2.5-flash for speed & efficiency)
# GEMINI_MODEL_DEFAULT=gemini-2.5-flash
# GEMINI_MODEL_REASONING=gemini-2.5-pro

# In-Memory Cache TTL in milliseconds (default: 15 minutes = 900000ms)
# CACHE_TTL_MS=900000

# Rate Limiter Window (default: 60 requests per 60 seconds per IP)
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_MS=60000
